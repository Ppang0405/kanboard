# Never ship local runtime data to the edge.
# Anchored to the repo root: an unanchored "data/" also excluded
# vendor/symfony/string/Resources/data/ from the published package.
/data/
/.git/
.DS_Store
# Local notes and tooling at the repo root (the web root) are not app files.
/.v2c/
/.video_agent/
/flue-*.md
/apply-deepseek-refresh.py
/deepseek-models-refresh.json
